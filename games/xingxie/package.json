{
  "name": "anime-survivor",
  "version": "1.3.2",
  "description": "《星屑轮舞》AnimeSurvivor - HTML5 Canvas 竖屏美少女割草小游戏",
  "main": "src/main.js",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:douyin": "node tools/build.mjs --target douyin",
    "build:wechat": "node tools/build.mjs --target wechat",
    "douyin:assets": "node tools/render_sfx.mjs && python3 tools/compress_images_tt.py && python3 tools/make_tt_bgm.py",
    "douyin:bgmcheck": "python3 tools/bgm_loop_check.py",
    "serve": "node tools/serve.js 8767",
    "start": "npm run build && node tools/serve.js 8767",
    "sim": "node tools/sim_balance.mjs 30",
    "voices": "node tools/generate_voices.mjs",
    "bgm": "python3 tools/compose_bgm.py",
    "package:win": "node tools/package.mjs win",
    "package:linux": "node tools/package.mjs linux",
    "desktop": "npm run build && electron desktop/main.js",
    "test": "node tools/test_logic.mjs",
    "test:browser": "node tools/test_browser.mjs",
    "test:douyin": "node tools/build.mjs --target douyin && node tools/test_douyin.mjs",
    "test:wechat": "node tools/build.mjs --target wechat && node tools/test_wechat.mjs",
    "release": "npm run package:win && node tools/make_release.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.0",
    "resedit": "^3.1.0"
  },
  "private": true,
  "type": "commonjs",
  "author": "狸猫"
}
