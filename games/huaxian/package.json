{
  "name": "anime-drawline",
  "version": "1.5.0",
  "description": "《画线守护美少女》AnimeDrawLine - HTML5 + Matter.js 画线物理解谜小游戏（出品：狸猫）",
  "main": "src/main.js",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.js 8766",
    "start": "npm run build && node tools/serve.js 8766",
    "process-images": "python tools/process_images.py",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/matter-js/build/matter.min.js','vendor/matter.min.js')\"",
    "verify": "node tools/verify_levels.mjs",
    "test": "node tools/verify_levels.mjs && node tools/test_physics.mjs && node tools/test.mjs",
    "voices": "node tools/generate_voices.mjs",
    "bgm": "python3 tools/compose_bgm.py",
    "package:win": "node tools/package.mjs win",
    "package:linux": "node tools/package.mjs linux",
    "desktop": "npm run build && electron desktop/main.js",
    "test:desktop": "node tools/test-desktop.mjs",
    "test:physics": "node tools/test_physics.mjs",
    "sloppy": "node tools/sloppy_bot.mjs",
    "build:douyin": "node tools/build-douyin.mjs",
    "test:douyin": "node tools/test-douyin.mjs",
    "sfx": "node tools/render-sfx.mjs",
    "build:wechat": "node tools/build-wechat.mjs",
    "test:wechat": "node tools/test-wechat.mjs",
    "release:zip": "python3 tools/make_release_zips.py out"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@napi-rs/canvas": "^1.0.11",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "matter-js": "^0.19.0",
    "playwright": "^1.64.0",
    "resedit": "^3.1.0"
  },
  "private": true,
  "type": "commonjs",
  "author": "狸猫",
  "productName": "画线守护美少女"
}
